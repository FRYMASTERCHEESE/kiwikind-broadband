# Generate your own 50+ character random secret. Never commit .env.
SECRET_KEY=
DEBUG=0
PUBLIC_ORIGIN=https://YOUR-DEDICATED-KIWIKIND-HOST
ALLOWED_HOSTS=YOUR-DEDICATED-KIWIKIND-HOST
CSRF_TRUSTED_ORIGINS=https://YOUR-DEDICATED-KIWIKIND-HOST
# Backend-only: set DATABASE_URL from Neon's connection details in your host secret manager.
# Never commit a real connection URL or include it in a website or Android build.
DATABASE_URL=
DB_SSLMODE=require
# SQLite fallback for local development when DATABASE_URL is empty.
DATABASE_PATH=/data/kiwikind.sqlite3
TRUST_PROXY_HTTPS=0
INTAKE_ENABLED=0
ADMIN_ENABLED=0
OWNER_GOOGLE_ADMIN_ENABLED=0
GOOGLE_WEB_CLIENT_ID=
PLAN_PUBLICATION_ENABLED=0
# Billing is not deployed; these gates also remain closed for future staged work.
STRIPE_TEST_CHECKOUT_ENABLED=0
STRIPE_TEST_PRICE_REVIEWED=0
LEGAL_ENTITY=
BUSINESS_CONTACT=
PRIVACY_CONTACT=
# Backend-only HTTPS transactional email on Brevo Free. Never put the key in clients.
EMAIL_BACKEND=portal.email_backend.BrevoEmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=KiwiKind Broadband <kiwikindbroadband@gmail.com>
EMAIL_REPLY_TO=kiwikindbroadband@gmail.com

# Set 1 for a known email transport outage; affects reset requests equally.
RESET_EMAIL_UNAVAILABLE=0

# Isolated Stripe sandbox. All are server-only; never put keys in web/Android code.
KIWIKIND_STRIPE_SANDBOX=0
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_ACCOUNT_ID=
