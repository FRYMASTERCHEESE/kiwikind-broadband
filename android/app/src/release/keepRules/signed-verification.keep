# Narrow reflection surface for existing same-signature release instrumentation.
# SDK consumer rules handle Credentials/Google ID/Ads. Never keep entire packages.
-keep,allowoptimization class nz.kiwikind.broadband.BannerAds
-keepclassmembers class nz.kiwikind.broadband.MainActivity {
    nz.kiwikind.broadband.BannerAds bannerAds;
    android.widget.LinearLayout content;
    void publicPage(java.lang.String);
    void auth(boolean);
    void policyScreen(java.lang.String);
}
-keepclassmembers class nz.kiwikind.broadband.BannerAds {
    com.google.android.ump.ConsentRequestParameters parameters;
    boolean formShowing;
    boolean consentUpdated;
    boolean loaded;
    boolean foreground;
    android.widget.TextView status;
    android.widget.LinearLayout slot;
    com.google.android.gms.ads.AdView banner;
    void privacyChoices();
    void pause();
    void resume();
}

# This existing cross-APK consent test constructs the public UMP configuration API.
# Preserve only these six named classes/interfaces; optimize all other SDK internals.
-keep class com.google.android.ump.UserMessagingPlatform { public *; }
-keep interface com.google.android.ump.ConsentInformation { public *; }
-keep class com.google.android.ump.ConsentRequestParameters { public *; }
-keep class com.google.android.ump.ConsentRequestParameters$Builder { public *; }
-keep class com.google.android.ump.ConsentDebugSettings { public *; }
-keep class com.google.android.ump.ConsentDebugSettings$Builder { public *; }

# Room creates this transitive WorkManager database through a no-argument constructor.
# Its consumer rule retains the class name but AGP full-mode also needs this member.
-keep class androidx.work.impl.WorkDatabase_Impl { public <init>(); }
